<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid dark ground behind the adaptive-icon foreground. This replaced the
  default Android Studio green grid, which was only ever invisible because
  the old foreground covered the whole canvas; padding the logo into the
  adaptive safe zone would have exposed it.

  The colour matches the logo badge's own dark edge, so the artwork reads as
  one piece under any launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0E1A06"
        android:pathData="M0,0h108v108h-108z" />
</vector>
