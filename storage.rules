rules_version = '2';

// See docs/03_database_schema.md for the storage layout this mirrors.
// Not yet deployed (no firebase.json in this repo) — tracked here as the
// reviewed source of truth until the Firebase CLI is wired up locally.
service firebase.storage {
  match /b/{bucket}/o {

    // Covers and free audio: public read (served straight to any listener),
    // writes only via server-side tooling (admin panel / Cloud Functions).
    match /covers/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /audio/free/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Premium audio: read requires sign-in; real entitlement gating happens
    // server-side (see docs/07_monetization.md) — this only blocks fully
    // anonymous access to the file URL.
    match /audio/premium/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /app/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
